<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tepeu</groupId>
        <artifactId>tepeu-os</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>tepeu-os-policy</artifactId>
    <name>Tepeu OS Policy</name>
    <description>Policy 封闭 union + 审批通道（端口；JDBC 在 persist；内存夹具在 src/test）</description>
    <dependencies>
        <dependency>
            <groupId>com.tepeu</groupId>
            <artifactId>tepeu-os-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tepeu</groupId>
            <artifactId>tepeu-os-syscall</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tepeu</groupId>
            <artifactId>tepeu-os-conformance</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>com/tepeu/os/policy/memory/InMemory*.class</include>
                                <include>com/tepeu/os/policy/conformance/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
