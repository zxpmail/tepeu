<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.tepeu</groupId>
    <artifactId>tepeu-host</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Tepeu Host</name>
    <description>⑤ CLI 宿主 — Spring Boot 4 接线 SqliteAssembly；不在 os/ 内核树内</description>

    <properties>
        <java.version>21</java.version>
        <tepeu-os.version>0.0.1-SNAPSHOT</tepeu-os.version>
        <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tepeu</groupId>
            <artifactId>tepeu-os-compose</artifactId>
            <version>${tepeu-os.version}</version>
        </dependency>
        <!-- 与 os/ 锁定同版，避免 Boot BOM 拉低 sqlite-jdbc -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.tepeu.os.host.TepeuHostApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
