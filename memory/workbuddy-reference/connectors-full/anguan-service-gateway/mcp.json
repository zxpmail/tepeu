{
  "mcpServers": {
    "anguan-service-gateway": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "anguan-service-gateway@1.8.0"],
      "runtime": {
        "type": "node",
        "version": "20"
      },
      "npmRegistry": "https://registry.npmmirror.com",
      "env": {
        "PLUGIN_SERVER_NAME": "anguan-plugin-prod",
        "PLUGIN_BASE_URL": "${PLUGIN_BASE_URL}",
        "PLUGIN_API_KEY": "${PLUGIN_API_KEY}",
        "PLUGIN_MACHINE_SECRET": "${PLUGIN_MACHINE_SECRET}"
      },
      "timeout": 30000
    }
  }
}
